{
  "actorSpecification": 1,
  "name": "social-media-api",
  "title": "Weibo, Xiaohongshu, Douyin, Threads, Bilibili, Zhihu & Tieba Data",
  "description": "Collect public posts, comments and account timelines from Weibo, Xiaohongshu (RedNote), Douyin, Threads, Bilibili, Zhihu and Baidu Tieba as JSON, using your LargitData Social Media Data API key.",
  "version": "0.1",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "platform",
              "url",
              "author",
              "content",
              "tm",
              "like_count",
              "comment_count",
              "share_count"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "url": {
                "label": "URL",
                "format": "link"
              },
              "content": {
                "label": "Content",
                "format": "text"
              },
              "tm": {
                "label": "Posted (unix time)",
                "format": "number"
              }
            }
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}
